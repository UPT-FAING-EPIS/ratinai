# MariaDB local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
# Defina la contraseña local solo en el archivo .env (no lo versiona Git).
DB_PASSWORD=

# Active la integración solo después de desplegar la API TFLite en EC2.
ANALYSIS_AI_ENABLED=false
ANALYSIS_API_URL=
# Defina esta clave solo en Azure App Service y en /etc/retinai-ai.env de EC2.
ANALYSIS_API_KEY=
