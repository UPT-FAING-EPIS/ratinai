# MariaDB local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
# Defina la contraseña local solo en el archivo .env (no lo versiona Git).
DB_PASSWORD=
APP_URL=http://ratinai.local

# Active la integración cuando la URL, la clave y el acceso de red a la CNN v1 de EC2 estén verificados.
ANALYSIS_AI_ENABLED=false
ANALYSIS_PROVIDER=remoto
ANALYSIS_CONTRACT_VERSION=v1
ANALYSIS_API_URL=
# Defina esta clave solo en Azure App Service y en /etc/retinai-ai.env de EC2.
ANALYSIS_API_KEY=

# Borrador híbrido del informe. La clave se usa únicamente en el servidor PHP.
REPORT_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
REPORT_AI_MODEL=gpt-5.6-terra
REPORT_AI_STORE=false

# OAuth de almacenamiento. Cada establecimiento conecta solo uno de los proveedores.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
MICROSOFT_ONEDRIVE_CLIENT_ID=
MICROSOFT_ONEDRIVE_CLIENT_SECRET=
MICROSOFT_ONEDRIVE_TENANT=common
MICROSOFT_ONEDRIVE_REDIRECT_URI=
DOCUMENT_TOKEN_ENCRYPTION_KEY=

# El mapa utiliza Leaflet y OpenStreetMap; no necesita clave de Google Maps.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=RetinAI Admins
