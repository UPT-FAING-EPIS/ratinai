[Unit]
Description=RetinAI TFLite inference API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/retinai/ai_service
EnvironmentFile=/etc/retinai-ai.env
ExecStart=/opt/retinai/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
