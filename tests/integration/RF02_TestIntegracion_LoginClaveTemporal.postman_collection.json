{
  "info":{"name":"RetinAI - RF02 - Integración Login con clave temporal","description":"Valida AuthController, sesión y redirección obligatoria. Use un médico de prueba con es_password_temporal=1.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"base_url","value":"http://ratinai.local"},{"key":"temp_doctor_email","value":""},{"key":"temp_doctor_password","value":""}],
  "item":[{"name":"RF02 - Login temporal","item":[{"name":"01 - Login de médico con clave temporal","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"email","value":"{{temp_doctor_email}}","type":"text"},{"key":"password","value":"{{temp_doctor_password}}","type":"text"}]},"url":"{{base_url}}/controllers/AuthController.php?action=login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('RF02: se fuerza el cambio de contraseña', function () {","  pm.expect(pm.response.code).to.be.oneOf([200, 302]);","  const target = (pm.response.headers.get('Location') || '') + pm.response.text();","  pm.expect(target).to.match(/change_password|Cambiar contraseña/i);","});"]}}]}]}]
