{
  "info":{"name":"RetinAI - RF03 - Integración Gestión de Médicos","description":"Actualiza un médico de prueba mediante DoctorController y confirma el dato en el listado. No use médicos reales.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"base_url","value":"http://ratinai.local"},{"key":"admin_email","value":""},{"key":"admin_password","value":""},{"key":"test_doctor_id","value":""},{"key":"test_doctor_name","value":""},{"key":"test_doctor_cmp","value":""},{"key":"test_doctor_specialty","value":"Oftalmología"},{"key":"updated_email","value":""}],
  "item":[{"name":"RF03 - Editar médico de prueba","item":[{"name":"01 - Autenticar administrador","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"email","value":"{{admin_email}}","type":"text"},{"key":"password","value":"{{admin_password}}","type":"text"}]},"url":"{{base_url}}/controllers/AuthController.php?action=login"}},{"name":"02 - Editar médico","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["pm.variables.set('updated_email', 'rf03.' + Date.now() + '@example.test');"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('RF03: DoctorController actualiza el médico', function () {","  pm.response.to.have.status(200);","  pm.expect(pm.response.json().success).to.eql(true);","});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"edit_id","value":"{{test_doctor_id}}","type":"text"},{"key":"nombre","value":"{{test_doctor_name}}","type":"text"},{"key":"correo","value":"{{updated_email}}","type":"text"},{"key":"cmp","value":"{{test_doctor_cmp}}","type":"text"},{"key":"especialidad","value":"{{test_doctor_specialty}}","type":"text"}]},"url":"{{base_url}}/controllers/DoctorController.php?action=edit"}},{"name":"03 - Verificar listado","request":{"method":"GET","url":"{{base_url}}/views/admin/doctor.php"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('RF03: el correo actualizado aparece en el listado', function () {","  pm.response.to.have.status(200);","  pm.expect(pm.response.text()).to.include(pm.variables.get('updated_email'));","});"]}}]}]}]
