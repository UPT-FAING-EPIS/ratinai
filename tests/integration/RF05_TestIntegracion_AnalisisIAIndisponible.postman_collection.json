{
  "info":{"name":"RetinAI - RF05 - Integración IA desactivada","description":"Valida que el análisis responde de forma controlada cuando la IA está temporalmente desactivada; no intenta contactar al modelo externo.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"base_url","value":"http://ratinai.local"},{"key":"doctor_email","value":""},{"key":"doctor_password","value":""}],
  "item":[{"name":"RF05 - Respuesta controlada de IA","item":[{"name":"01 - Autenticar médico","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"email","value":"{{doctor_email}}","type":"text"},{"key":"password","value":"{{doctor_password}}","type":"text"}]},"url":"{{base_url}}/controllers/AuthController.php?action=login"}},{"name":"02 - Solicitar análisis con IA desactivada","request":{"method":"POST","url":"{{base_url}}/controllers/AnalisisController.php?action=analizar"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('RF05: la IA desactivada responde sin error del servidor', function () {","  pm.response.to.have.status(200);","  const body = pm.response.json();","  pm.expect(body.success).to.eql(false);","  pm.expect(body.ai_disabled).to.eql(true);","  pm.expect(body.error).to.match(/temporalmente desactivado/i);","});"]}}]}]}]
