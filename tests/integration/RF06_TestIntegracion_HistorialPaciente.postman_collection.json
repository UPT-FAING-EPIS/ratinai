{
  "info":{"name":"RetinAI - RF06 - Integración Historial de Paciente","description":"Registra un paciente de prueba y confirma que una segunda consulta recupera el mismo código sin duplicarlo.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"base_url","value":"http://ratinai.local"},{"key":"patient_dni","value":""},{"key":"patient_code","value":""}],
  "item":[{"name":"RF06 - Código único de historial","item":[{"name":"01 - Registrar paciente de prueba","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["const dni = String(Math.floor(10000000 + Math.random() * 89999999));","pm.variables.set('patient_dni', dni);"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('RF06: se registra el paciente y se genera código', function () {","  pm.response.to.have.status(200);","  const body = pm.response.json();","  pm.expect(body.success).to.eql(true);","  pm.expect(body.nuevo).to.eql(true);","  pm.expect(body.paciente.codigo_paciente).to.match(/^PAC-/);","  pm.variables.set('patient_code', body.paciente.codigo_paciente);","});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"dni","value":"{{patient_dni}}","type":"text"}]},"url":"{{base_url}}/controllers/PacienteController.php?action=buscar_registrar"}},{"name":"02 - Recuperar paciente sin duplicarlo","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"dni","value":"{{patient_dni}}","type":"text"}]},"url":"{{base_url}}/controllers/PacienteController.php?action=buscar_registrar"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('RF06: se conserva el código y no se duplica el paciente', function () {","  const body = pm.response.json();","  pm.expect(body.success).to.eql(true);","  pm.expect(body.nuevo).to.eql(false);","  pm.expect(body.paciente.codigo_paciente).to.eql(pm.variables.get('patient_code'));","});"]}}]}]}]
}
