{
  "info":{"name":"RetinAI - RF07 - Integración Recuperar Código","description":"Valida rechazo de DNI inválido y recuperación del código de un paciente con análisis asociados al médico de prueba.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"base_url","value":"http://ratinai.local"},{"key":"doctor_email","value":""},{"key":"doctor_password","value":""},{"key":"history_dni","value":""}],
  "item":[{"name":"RF07 - Recuperar código por DNI","item":[{"name":"01 - Autenticar médico","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"email","value":"{{doctor_email}}","type":"text"},{"key":"password","value":"{{doctor_password}}","type":"text"}]},"url":"{{base_url}}/controllers/AuthController.php?action=login"}},{"name":"02 - Rechazar DNI inválido","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"dni","value":"1234ABCD","type":"text"}]},"url":"{{base_url}}/controllers/PacienteController.php?action=recuperar_codigo"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('RF07: el DNI inválido se rechaza antes de consultar', function () {","  const body = pm.response.json();","  pm.expect(body.success).to.eql(false);","  pm.expect(body.error).to.match(/exactamente 8 dígitos/i);","});"]}}]},{"name":"03 - Recuperar código válido","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"dni","value":"{{history_dni}}","type":"text"}]},"url":"{{base_url}}/controllers/PacienteController.php?action=recuperar_codigo"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('RF07: se devuelve el código de historial', function () {","  const body = pm.response.json();","  pm.expect(body.success).to.eql(true);","  pm.expect(body.paciente.codigo_paciente).to.match(/^PAC-/);","});"]}}]}]}]
